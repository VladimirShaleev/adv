{
  "name": "vm-js",
  "version": "@PROJECT_VERSION@",
  "description": "The Adv virtual machine for JavaScript and WebAssembly",
  "main": "./vm-js.js",
  "module": "./vm-js.esm.mjs",
  "types": "./vm-js.d.ts",
  "exports": {
    ".": {
      "types": "./vm-js.d.ts",
      "import": "./vm-js.esm.mjs",
      "require": "./vm-js.js"
    }
  },
  "files": [
    @VM_JS_WASM@"vm-js.js",
    "vm-js.esm.mjs",
    "vm-js.d.ts",
    "vm-js.esm.d.ts"
  ]
}
