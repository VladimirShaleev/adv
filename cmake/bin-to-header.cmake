if(NOT INPUT_FILE OR NOT OUTPUT_FILE OR NOT ARRAY_NAME)
    message(FATAL_ERROR "Missing required variables: INPUT_FILE, OUTPUT_FILE, or ARRAY_NAME")
endif()

string(REPLACE "\"" "" INPUT_FILE "${INPUT_FILE}")
string(REPLACE "\"" "" OUTPUT_FILE "${OUTPUT_FILE}")
string(REPLACE "\"" "" ARRAY_NAME "${ARRAY_NAME}")

get_filename_component(FILENAME "${INPUT_FILE}" NAME_WE)
string(TOUPPER "${FILENAME}" FILENAME)
string(APPEND FILENAME "_HPP")

file(READ "${INPUT_FILE}" hex_content HEX)
string(REGEX REPLACE "(..)" "0x\\1, " formatted_hex "${hex_content}")

file(WRITE "${OUTPUT_FILE}" 
    "// Auto-generated by CMake. Do not edit.\n"
    "#ifndef ${FILENAME}\n"
    "#define ${FILENAME}\n\n"
    "#include <cstddef>\n"
    "#include <cstdint>\n\n"
    "inline constexpr std::uint8_t ${ARRAY_NAME}_bytecode[] = {\n"
    "    ${formatted_hex}\n"
    "};\n\n"
    "inline constexpr std::size_t ${ARRAY_NAME}_bytecode_size = sizeof(${ARRAY_NAME}_bytecode);\n\n"
    "#endif // ${FILENAME}\n")
