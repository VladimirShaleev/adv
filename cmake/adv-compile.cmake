function(adv_compile)
    set(options WARN_AS_ERRORS TEXT)
    set(one_value NAME OUT_DIR)
    set(multi_value IMPORT_DIRS SOURCES DEPENDENCIES)
    cmake_parse_arguments(PARSE_ARGV 0 ADVC_ARG "${options}" "${one_value}" "${multi_value}")
    if(NOT ADVC_ARG_OUT_DIR)
        set(ADVC_ARG_OUT_DIR ${CMAKE_CURRENT_BINARY_DIR})
    endif()
    set(ADVC_ARG_CMD "")
    if(ADVC_ARG_WARN_AS_ERRORS)
        list(APPEND ADVC_ARG_CMD "-w")
    endif()
    if(ADVC_ARG_TEXT)
        list(APPEND ADVC_ARG_CMD "-t")
    endif()
    foreach(IMPORT_DIR ${ADVC_ARG_IMPORT_DIRS})
        list(APPEND ADVC_ARG_CMD "-i" "\"${IMPORT_DIR}\"")
    endforeach()
    function(get_module_name filename out_var)
        get_filename_component(filename_str "${filename}" NAME_WE)
        if("${filename_str}" STREQUAL "")
            set(${out_var} "" PARENT_SCOPE)
            return()
        endif()
        string(TOLOWER "${filename_str}" name)
        string(REGEX REPLACE "[^a-z0-9]+" "_" name "${name}")
        string(REGEX REPLACE "^_+" "" name "${name}")
        string(REGEX REPLACE "_+$" "" name "${name}")
        set(${out_var} "${name}" PARENT_SCOPE)
    endfunction()
    set(ADVC_GENERATED_ALL)
    foreach(SOURCE ${ADVC_ARG_SOURCES})
        get_module_name(${SOURCE} MODULE_NAME)
        if(ADVC_ARG_TEXT)
            string(APPEND MODULE_NAME ".adt")
        else()
            string(APPEND MODULE_NAME ".adb")
        endif()
        cmake_path(APPEND ADVC_GENERATED_FILE "${ADVC_ARG_OUT_DIR}" "${MODULE_NAME}")
        list(APPEND ADVC_GENERATED_ALL ${ADVC_GENERATED_FILE})
        add_custom_command(
            OUTPUT ${ADVC_GENERATED_FILE}
            COMMAND adv::advc ${ADVC_ARG_CMD} -o ${ADVC_GENERATED_FILE} ${SOURCE}
            VERBATIM
            DEPENDS ${SOURCE} ${ADVC_ARG_DEPENDENCIES}
            COMMENT "[advc] Building ADV ${MODULE_NAME}")
    endforeach()
    set_source_files_properties(${ADVC_GENERATED_ALL} PROPERTIES GENERATED TRUE)
    if(ADVC_ARG_NAME)
        set(ADVC_${ADVC_ARG_NAME}_OUTPUTS ${ADVC_GENERATED_ALL} PARENT_SCOPE)  
    endif()
endfunction()
