/**
 * @file      ${HEADER_NAME}
 * @brief     Library version information and utilities.
 * @details   This header provides version information for the ${LIB_PREFIX} library,
 *            including version number components and macros for version comparison
 *            and string generation. It supports:
 *            - Major/Minor/Micro version components
 *            - Integer version encoding
 *            - String version generation
 *            
 * @author    Vladimir Shaleev <vladimirshaleev@gmail.com>
 * @ingroup   files
 * @copyright MIT License
 */
#ifndef ${LIB_PREFIX}_VERSION_H
#define ${LIB_PREFIX}_VERSION_H

/**
 * @name  Version Components.
 * @brief Individual components of the library version.
 * @{
 */

/**
 * @brief   Major version number (API-breaking changes).
 * @sa      ${LIB_PREFIX}_VERSION
 * @sa      ${LIB_PREFIX}_VERSION_STRING
 * @ingroup macros
 */
#define ${LIB_PREFIX}_VERSION_MAJOR ${PROJECT_VERSION_MAJOR}

/**
 * @brief   Minor version number (backwards-compatible additions).
 * @sa      ${LIB_PREFIX}_VERSION
 * @sa      ${LIB_PREFIX}_VERSION_STRING
 * @ingroup macros
 */
#define ${LIB_PREFIX}_VERSION_MINOR ${PROJECT_VERSION_MINOR}

/**
 * @brief   Micro version number (bug fixes and patches).
 * @sa      ${LIB_PREFIX}_VERSION
 * @sa      ${LIB_PREFIX}_VERSION_STRING
 * @ingroup macros
 */
#define ${LIB_PREFIX}_VERSION_MICRO ${PROJECT_VERSION_PATCH}

/** @} */

/**
 * @name  Version Utilities.
 * @brief Macros for working with version numbers.
 * @{
 */

/**
 * @brief     Encodes version components into a single integer.
 * @details   Combines major, minor, and micro versions into a 32-bit value:
 *            - Bits 24-31: Major version (0-255)
 *            - Bits 16-23: Minor version (0-255)
 *            - Bits 0-15: Micro version (0-65535)
 *            The encoded value can be compared numerically when each component
 *            is within its documented range.
 * @param[in] major Major version number.
 * @param[in] minor Minor version number.
 * @param[in] micro Micro version number.
 * @return    Encoded version as unsigned long.
 * @sa        ${LIB_PREFIX}_VERSION
 * @ingroup   macros
 */
#define ${LIB_PREFIX}_VERSION_ENCODE(major, minor, micro) \
    ((((unsigned long)(major)) << 24) | (((unsigned long)(minor)) << 16) | (unsigned long)(micro))

/**
 * @brief     Internal macro for string version generation.
 * @details   Helper macro that stringizes version components (e.g., ${PROJECT_VERSION_MAJOR}, ${PROJECT_VERSION_MINOR}, ${PROJECT_VERSION_PATCH} -> "${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}").
 * @param[in] major Major version number.
 * @param[in] minor Minor version number.
 * @param[in] micro Micro version number.
 * @return    Stringified version.
 * @note      For internal use only.
 * @ingroup   macros
 * @private
 */
#define ${LIB_PREFIX}_VERSION_STRINGIZE_(major, minor, micro) #major "." #minor "." #micro

/**
 * @brief     Creates version string from components.
 * @details   Generates a string literal from version components (e.g., ${PROJECT_VERSION_MAJOR}, ${PROJECT_VERSION_MINOR}, ${PROJECT_VERSION_PATCH} -> "${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}").
 * @param[in] major Major version number.
 * @param[in] minor Minor version number.
 * @param[in] micro Micro version number.
 * @return    Stringified version.
 * @sa        ${LIB_PREFIX}_VERSION_STRING
 * @ingroup   macros
 */
#define ${LIB_PREFIX}_VERSION_STRINGIZE(major, minor, micro)  ${LIB_PREFIX}_VERSION_STRINGIZE_(major, minor, micro)

/** @} */

/**
 * @name  Current Version.
 * @brief Macros representing the current library version.
 * @{
 */

/**
 * @brief   Encoded library version as integer.
 * @details Combined version value suitable for numeric comparisons.
 *          Use #${LIB_PREFIX}_VERSION_STRING for human-readable format.
 * @sa      ${LIB_PREFIX}_VERSION_STRING
 * @ingroup macros
 */
#define ${LIB_PREFIX}_VERSION ${LIB_PREFIX}_VERSION_ENCODE( \
    ${LIB_PREFIX}_VERSION_MAJOR, \
    ${LIB_PREFIX}_VERSION_MINOR, \
    ${LIB_PREFIX}_VERSION_MICRO)

/**
 * @brief   Library version as human-readable string.
 * @details Version string in "MAJOR.MINOR.MICRO" format (e.g., "1.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_PATCH}").
 *          Use #${LIB_PREFIX}_VERSION for numeric comparisons.
 * @sa      ${LIB_PREFIX}_VERSION
 * @ingroup macros
 */
#define ${LIB_PREFIX}_VERSION_STRING ${LIB_PREFIX}_VERSION_STRINGIZE( \
    ${LIB_PREFIX}_VERSION_MAJOR, \
    ${LIB_PREFIX}_VERSION_MINOR, \
    ${LIB_PREFIX}_VERSION_MICRO)

/** @} */

#endif /* ${LIB_PREFIX}_VERSION_H */
