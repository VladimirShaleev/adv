{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "vcpkg",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "release",
            "displayName": "Release configuration",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug configuration",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "win64-base",
            "displayName": "Windows 64-bit configuration",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "osx-base",
            "displayName": "Mac OS base configuration",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-osx"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "linux-base",
            "displayName": "Linux base configuration",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "wasm-base",
            "displayName": "WebAssembly base configuration",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "ADV_BUILD_DOC": "OFF",
                "ADV_BUILD_TOOL": "OFF",
                "ADV_BUILD_TESTS": "OFF",
                "ADV_ENABLE_INSTALL": "OFF"
            }
        },
        {
            "name": "win64-release",
            "displayName": "Windows x64 (release)",
            "inherits": [
                "win64-base",
                "release",
                "vcpkg"
            ]
        },
        {
            "name": "win64-debug",
            "displayName": "Windows x64 (debug)",
            "inherits": [
                "win64-base",
                "debug",
                "vcpkg"
            ]
        },
        {
            "name": "osx-release",
            "displayName": "Mac OS config (release)",
            "inherits": [
                "osx-base",
                "release",
                "vcpkg"
            ]
        },
        {
            "name": "osx-debug",
            "displayName": "Mac OS config (debug)",
            "inherits": [
                "osx-base",
                "debug",
                "vcpkg"
            ]
        },
        {
            "name": "linux-release",
            "displayName": "Linux config (release)",
            "inherits": [
                "linux-base",
                "release",
                "vcpkg"
            ]
        },
        {
            "name": "linux-debug",
            "displayName": "Linux config (debug)",
            "inherits": [
                "linux-base",
                "debug",
                "vcpkg"
            ]
        },
        {
            "name": "wasm-release",
            "displayName": "WebAssembly (release)",
            "inherits": [
                "wasm-base",
                "release",
                "vcpkg"
            ]
        },
        {
            "name": "wasm-debug",
            "displayName": "WebAssembly (debug)",
            "inherits": [
                "wasm-base",
                "debug",
                "vcpkg"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "win64-release",
            "displayName": "Windows x64 (release)",
            "configurePreset": "win64-release",
            "configuration": "Release"
        },
        {
            "name": "win64-debug",
            "displayName": "Windows x64 (debug)",
            "configurePreset": "win64-debug",
            "configuration": "Debug"
        },
        {
            "name": "osx-release",
            "displayName": "Mac OS (release)",
            "configurePreset": "osx-release"
        },
        {
            "name": "osx-debug",
            "displayName": "Mac OS (debug)",
            "configurePreset": "osx-debug"
        },
        {
            "name": "linux-release",
            "displayName": "Linux (release)",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-debug",
            "displayName": "Linux (debug)",
            "configurePreset": "linux-debug"
        },
        {
            "name": "wasm-release",
            "displayName": "WebAssembly (release)",
            "configurePreset": "wasm-release"
        },
        {
            "name": "wasm-debug",
            "displayName": "WebAssembly (debug)",
            "configurePreset": "wasm-debug"
        }
    ],
    "testPresets": [
        {
            "name": "win64-release",
            "displayName": "Windows x64 (release)",
            "configurePreset": "win64-release"
        },
        {
            "name": "win64-debug",
            "displayName": "Windows x64 (debug)",
            "configurePreset": "win64-debug"
        },
        {
            "name": "osx-release",
            "displayName": "Mac OS (release)",
            "configurePreset": "osx-release"
        },
        {
            "name": "osx-debug",
            "displayName": "Mac OS (debug)",
            "configurePreset": "osx-debug"
        },
        {
            "name": "linux-release",
            "displayName": "Linux (release)",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-debug",
            "displayName": "Linux (debug)",
            "configurePreset": "linux-debug"
        }
    ],
    "packagePresets": [
        {
            "name": "win64-release",
            "displayName": "Windows x64 (release)",
            "configurePreset": "win64-release"
        },
        {
            "name": "win64-debug",
            "displayName": "Windows x64 (debug)",
            "configurePreset": "win64-debug"
        }
    ],
    "workflowPresets": [
        {
            "name": "win64-release",
            "displayName": "Windows x64 (release)",
            "steps": [
                {
                    "type": "configure",
                    "name": "win64-release"
                },
                {
                    "type": "build",
                    "name": "win64-release"
                },
                {
                    "type": "test",
                    "name": "win64-release"
                },
                {
                    "type": "package",
                    "name": "win64-release"
                }
            ]
        },
        {
            "name": "win64-debug",
            "displayName": "Windows x64 (debug)",
            "steps": [
                {
                    "type": "configure",
                    "name": "win64-debug"
                },
                {
                    "type": "build",
                    "name": "win64-debug"
                },
                {
                    "type": "test",
                    "name": "win64-debug"
                },
                {
                    "type": "package",
                    "name": "win64-debug"
                }
            ]
        },
        {
            "name": "osx-release",
            "displayName": "Mac OS (release)",
            "steps": [
                {
                    "type": "configure",
                    "name": "osx-release"
                },
                {
                    "type": "build",
                    "name": "osx-release"
                },
                {
                    "type": "test",
                    "name": "osx-release"
                }
            ]
        },
        {
            "name": "osx-debug",
            "displayName": "Mac OS (debug)",
            "steps": [
                {
                    "type": "configure",
                    "name": "osx-debug"
                },
                {
                    "type": "build",
                    "name": "osx-debug"
                },
                {
                    "type": "test",
                    "name": "osx-debug"
                }
            ]
        },
        {
            "name": "linux-release",
            "displayName": "Linux (release)",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-release"
                },
                {
                    "type": "build",
                    "name": "linux-release"
                },
                {
                    "type": "test",
                    "name": "linux-release"
                }
            ]
        },
        {
            "name": "linux-debug",
            "displayName": "Linux (debug)",
            "steps": [
                {
                    "type": "configure",
                    "name": "linux-debug"
                },
                {
                    "type": "build",
                    "name": "linux-debug"
                },
                {
                    "type": "test",
                    "name": "linux-debug"
                }
            ]
        }
    ]
}
